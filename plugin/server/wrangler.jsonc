{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentcast",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "SessionDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [{ "binding": "VECTORS", "index_name": "agentcast-sessions", "remote": true }],
  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "agentcast-archive" }],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "ASK_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true },
  "vars": {
    "SESSION_TTL_HOURS": "24",
    "MAX_EVENTS": "20000",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "EMBED_MODEL": "@cf/baai/bge-small-en-v1.5",
    "MAX_TTL_HOURS": "8760",
    "ARCHIVE_EVICT_HOURS": "24",
    "AGENTCAST_VERSION": "0.4.0"
  }
}
